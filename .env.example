# signal-cli-rest-api address, no protocol
SIGNAL_SERVICE="127.0.0.1:8080"
# Bot's Signal number in E.164 format, e.g. +441632960001
PHONE_NUMBER=""
# Signal group the bot listens to, "group." prefix included
GROUP_ID=""
# taky server — your machine's LAN IP (must match public_ip in taky.conf)
TAK_HOST=""
# taky CoT port (taky.conf [cot_server] port)
TAK_PORT="8089"
